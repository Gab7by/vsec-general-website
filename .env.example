# ---- Server-only secrets for the /api functions ----
# Set in Vercel → Project → Settings → Environment Variables, and in a local .env.local (gitignored).
# Never prefix these with VITE_.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
LETTER_FROM=VSEC College Admissions <admissions@vseccollege.com>
# Optional: defaults to vseccollege@gmail.com. Set LETTER_BCC= (empty) to disable the record copy.
# LETTER_REPLY_TO=
# LETTER_BCC=

# ---- Public values bundled into the browser for admin sign-in (safe to expose) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
